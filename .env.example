# --- Web (Vercel) ---
# Preview gate — every route requires HTTP Basic Auth.
# FAIL CLOSED: if PREVIEW_PASSWORD is unset, empty, or CHANGE_ME, everything returns 401.
PREVIEW_USERNAME=preview
PREVIEW_PASSWORD=CHANGE_ME

# Neon Postgres (pulled via `vercel env pull .env.local`)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Engine (Python, engine/) ---
# All engine config in engine/config.toml is overridable via SOURCEMODE_* env vars.
SOURCEMODE_COMFYUI_HOST=127.0.0.1
SOURCEMODE_COMFYUI_PORT=8188
SOURCEMODE_MODELS_DIR=
SOURCEMODE_LORAS_DIR=
SOURCEMODE_OUTPUTS_DIR=
SOURCEMODE_MUSUBI_TUNER_PATH=
SOURCEMODE_IDENTITY_GATE_ENABLED=true
SOURCEMODE_QWEN3_URL=http://127.0.0.1:11434/v1
