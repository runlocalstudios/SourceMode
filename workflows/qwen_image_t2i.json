{
  "_meta": {
    "warning": "TEMPLATE-UNVERIFIED — written from the standard ComfyUI Qwen-Image T2I example structure, NOT exported from a live ComfyUI. No Qwen-Image DiT was present in C:\\ComfyUI\\models at inventory time; download the model and verify against a real export before first GPU run (see BACKLOG.md).",
    "template": "qwen_image_t2i",
    "placeholders": ["MODEL", "TEXT_ENCODER", "VAE", "POSITIVE", "NEGATIVE", "LORA_PATH", "LORA_STRENGTH", "SEED", "STEPS", "CFG", "WIDTH", "HEIGHT", "FILENAME_PREFIX"]
  },
  "nodes": {
    "37": {
      "class_type": "UNETLoader",
      "inputs": { "unet_name": "{{MODEL}}", "weight_dtype": "default" }
    },
    "66": {
      "class_type": "ModelSamplingAuraFlow",
      "inputs": { "model": ["73", 0], "shift": 3.1 }
    },
    "73": {
      "class_type": "LoraLoaderModelOnly",
      "inputs": { "model": ["37", 0], "lora_name": "{{LORA_PATH}}", "strength_model": "{{LORA_STRENGTH}}" }
    },
    "38": {
      "class_type": "CLIPLoader",
      "inputs": { "clip_name": "{{TEXT_ENCODER}}", "type": "qwen_image", "device": "default" }
    },
    "39": {
      "class_type": "VAELoader",
      "inputs": { "vae_name": "{{VAE}}" }
    },
    "6": {
      "class_type": "CLIPTextEncode",
      "inputs": { "text": "{{POSITIVE}}", "clip": ["38", 0] }
    },
    "7": {
      "class_type": "CLIPTextEncode",
      "inputs": { "text": "{{NEGATIVE}}", "clip": ["38", 0] }
    },
    "58": {
      "class_type": "EmptySD3LatentImage",
      "inputs": { "width": "{{WIDTH}}", "height": "{{HEIGHT}}", "batch_size": 1 }
    },
    "3": {
      "class_type": "KSampler",
      "inputs": {
        "model": ["66", 0],
        "positive": ["6", 0],
        "negative": ["7", 0],
        "latent_image": ["58", 0],
        "seed": "{{SEED}}",
        "steps": "{{STEPS}}",
        "cfg": "{{CFG}}",
        "sampler_name": "euler",
        "scheduler": "simple",
        "denoise": 1.0
      }
    },
    "8": {
      "class_type": "VAEDecode",
      "inputs": { "samples": ["3", 0], "vae": ["39", 0] }
    },
    "60": {
      "class_type": "SaveImage",
      "inputs": { "images": ["8", 0], "filename_prefix": "{{FILENAME_PREFIX}}" }
    }
  }
}
