{
  "_meta": {
    "verified": "Built 2026-09-18. Masked inpaint on an image we already made: VAEEncode the original, SetLatentNoiseMask so only the masked latent is denoised, then ImageCompositeMasked the decode back onto the ORIGINAL pixels. That last node is the point - everything outside the mask is provably the original image, so a 90%-keeper's face, hair and composition cannot drift while one region is fixed.",
    "template": "qwen_image_inpaint",
    "placeholders": ["MODEL", "TEXT_ENCODER", "VAE", "POSITIVE", "NEGATIVE", "IMAGE", "MASK", "LORA_PATH", "LORA_STRENGTH", "LIGHTNING", "LIGHTNING_STRENGTH", "SHIFT", "SEED", "STEPS", "CFG", "DENOISE", "GROW", "FEATHER", "FILENAME_PREFIX"],
    "notes": "No resize anywhere: FluxKontextImageScale would eat detail and break the composite alignment. GROW/FEATHER soften the mask edge so the seam does not show.",
    "prunable_loras": "Empty lora_name values are pruned by render.workflow.prune_placeholder_loras before submit."
  },
  "nodes": {
    "37": { "class_type": "UNETLoader",
            "inputs": { "unet_name": "{{MODEL}}", "weight_dtype": "default" } },
    "73": { "class_type": "LoraLoaderModelOnly",
            "inputs": { "model": ["37", 0], "lora_name": "{{LORA_PATH}}", "strength_model": "{{LORA_STRENGTH}}" } },
    "74": { "class_type": "LoraLoaderModelOnly",
            "inputs": { "model": ["73", 0], "lora_name": "{{LIGHTNING}}", "strength_model": "{{LIGHTNING_STRENGTH}}" } },
    "66": { "class_type": "ModelSamplingAuraFlow",
            "inputs": { "model": ["74", 0], "shift": "{{SHIFT}}" } },
    "38": { "class_type": "CLIPLoader",
            "inputs": { "clip_name": "{{TEXT_ENCODER}}", "type": "qwen_image", "device": "default" } },
    "39": { "class_type": "VAELoader",
            "inputs": { "vae_name": "{{VAE}}" } },
    "6":  { "class_type": "CLIPTextEncode",
            "inputs": { "text": "{{POSITIVE}}", "clip": ["38", 0] } },
    "7":  { "class_type": "CLIPTextEncode",
            "inputs": { "text": "{{NEGATIVE}}", "clip": ["38", 0] } },
    "20": { "class_type": "LoadImage",
            "inputs": { "image": "{{IMAGE}}" } },
    "21": { "class_type": "LoadImageMask",
            "inputs": { "image": "{{MASK}}", "channel": "red" } },
    "22": { "class_type": "GrowMask",
            "inputs": { "mask": ["21", 0], "expand": "{{GROW}}", "tapered_corners": true } },
    "23": { "class_type": "FeatherMask",
            "inputs": { "mask": ["22", 0], "left": "{{FEATHER}}", "top": "{{FEATHER}}",
                        "right": "{{FEATHER}}", "bottom": "{{FEATHER}}" } },
    "24": { "class_type": "VAEEncode",
            "inputs": { "pixels": ["20", 0], "vae": ["39", 0] } },
    "25": { "class_type": "SetLatentNoiseMask",
            "inputs": { "samples": ["24", 0], "mask": ["23", 0] } },
    "3":  { "class_type": "KSampler",
            "inputs": { "model": ["66", 0], "positive": ["6", 0], "negative": ["7", 0],
                        "latent_image": ["25", 0], "seed": "{{SEED}}", "steps": "{{STEPS}}",
                        "cfg": "{{CFG}}", "sampler_name": "euler", "scheduler": "simple",
                        "denoise": "{{DENOISE}}" } },
    "8":  { "class_type": "VAEDecode",
            "inputs": { "samples": ["3", 0], "vae": ["39", 0] } },
    "26": { "class_type": "ImageCompositeMasked",
            "inputs": { "destination": ["20", 0], "source": ["8", 0], "x": 0, "y": 0,
                        "resize_source": false, "mask": ["23", 0] } },
    "60": { "class_type": "SaveImage",
            "inputs": { "images": ["26", 0], "filename_prefix": "{{FILENAME_PREFIX}}" } }
  }
}
