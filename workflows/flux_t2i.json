{
  "_meta": {
    "verified": "Built 2026-09-17 for the jojo Flux.1-dev COMPARISON LoRA. Standard Flux text-to-image chain: UNET -> character LoRA -> DualCLIP(clip_l + t5xxl) -> FluxGuidance -> KSampler(euler/simple, cfg 1). Flux.1-dev is NON-COMMERCIAL: this graph exists to benchmark our Qwen pipeline against a known trainer on identical data and captions, and nothing rendered through it ships.",
    "template": "flux_t2i",
    "placeholders": ["MODEL", "CLIP_L", "T5", "VAE", "POSITIVE", "NEGATIVE", "LORA_PATH", "LORA_STRENGTH", "GUIDANCE", "SEED", "STEPS", "WIDTH", "HEIGHT", "FILENAME_PREFIX"],
    "prunable_loras": "Empty/placeholder lora_name values are pruned by render.workflow.prune_placeholder_loras before submit."
  },
  "nodes": {
    "1": { "class_type": "UNETLoader",
           "inputs": { "unet_name": "{{MODEL}}", "weight_dtype": "default" } },
    "2": { "class_type": "LoraLoaderModelOnly",
           "inputs": { "model": ["1", 0], "lora_name": "{{LORA_PATH}}", "strength_model": "{{LORA_STRENGTH}}" } },
    "3": { "class_type": "DualCLIPLoader",
           "inputs": { "clip_name1": "{{CLIP_L}}", "clip_name2": "{{T5}}", "type": "flux" } },
    "4": { "class_type": "VAELoader",
           "inputs": { "vae_name": "{{VAE}}" } },
    "5": { "class_type": "CLIPTextEncode",
           "inputs": { "clip": ["3", 0], "text": "{{POSITIVE}}" } },
    "6": { "class_type": "FluxGuidance",
           "inputs": { "conditioning": ["5", 0], "guidance": "{{GUIDANCE}}" } },
    "7": { "class_type": "CLIPTextEncode",
           "inputs": { "clip": ["3", 0], "text": "{{NEGATIVE}}" } },
    "8": { "class_type": "EmptySD3LatentImage",
           "inputs": { "width": "{{WIDTH}}", "height": "{{HEIGHT}}", "batch_size": 1 } },
    "9": { "class_type": "KSampler",
           "inputs": { "model": ["2", 0], "positive": ["6", 0], "negative": ["7", 0], "latent_image": ["8", 0],
                       "seed": "{{SEED}}", "steps": "{{STEPS}}", "cfg": 1.0,
                       "sampler_name": "euler", "scheduler": "simple", "denoise": 1.0 } },
    "10": { "class_type": "VAEDecode",
            "inputs": { "samples": ["9", 0], "vae": ["4", 0] } },
    "11": { "class_type": "SaveImage",
            "inputs": { "images": ["10", 0], "filename_prefix": "{{FILENAME_PREFIX}}" } }
  }
}
