.DS_Store

# env files (secrets)
.env*
!.env.example

# local dev resources/assets (never committed)
/devresources/
/devassets/

# python engine
engine/.venv/
engine/**/__pycache__/
engine/.pytest_cache/
engine/*.egg-info/
engine/outputs/
outputs/
/library/

# generated artifacts
characters/**/dataset/
characters/**/_rejected/

# trained model weights never live in git (LoRAs go to ComfyUI models/loras/)
*.safetensors
*.pth


# pose landmarker model (30MB, re-downloadable)
engine/models/*.task

# pose-library working artifacts: rejected candidates and pre-overwrite backups.
# The CHOSEN reference photos (pose-library/*.png) are committed.
pose-library/_candidates/
pose-library/_prev/
pose-library/_probe/
