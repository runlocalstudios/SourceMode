# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local dev resources/assets (never committed)
/devresources/
/devassets/

# python engine
engine/.venv/
engine/**/__pycache__/
engine/.pytest_cache/
engine/*.egg-info/
engine/outputs/
outputs/

# generated artifacts
characters/**/dataset/
characters/**/_rejected/

# trained model weights never live in git (LoRAs go to ComfyUI models/loras/)
*.safetensors
*.pth

.vercel
.env*
!.env.example

# pose landmarker model (30MB, re-downloadable)
engine/models/*.task

# pose-library working artifacts: rejected candidates and pre-overwrite backups.
# The CHOSEN reference photos (pose-library/*.png) are committed.
pose-library/_candidates/
pose-library/_prev/
pose-library/_probe/
